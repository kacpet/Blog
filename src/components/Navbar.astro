---
import ThemeToggle from './ThemeToggle.astro'
---

<nav
  class="fixed top-0 left-0 z-50 w-full border-b border-[var(--border)] bg-[var(--background)]"
>
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-6"
  >
    <a
      href="/"
      class="transition-opacity duration-300 hover:opacity-60"
      aria-label="Strona główna"
    >
      <img
        src="/logo.svg"
        alt="KACPET"
        class="h-12 w-auto"
      />
    </a>

    <div class="flex items-center gap-8">
      <a
        href="/"
        class="text-base transition-opacity duration-300 hover:opacity-60"
      >
        Home
      </a>

      <a
        href="/blog"
        class="text-base transition-opacity duration-300 hover:opacity-60"
      >
        Blog
      </a>

      <a
        href="/about"
        class="text-base transition-opacity duration-300 hover:opacity-60"
      >
        About me
      </a>

      <ThemeToggle />
    </div>
  </div>
</nav>
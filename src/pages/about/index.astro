---
import Layout from '../../layouts/Layout.astro'
---

<Layout>
  <main>
    <!-- Hero -->
    <section class="border-b border-[var(--border)]">
      <div class="mx-auto max-w-7xl px-6 pb-20 pt-32 sm:pb-28 sm:pt-40">
        <div class="max-w-4xl">
          <p
            class="animate-item text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
          >
            About me
          </p>

          <h1
            class="animate-item delay-100 mt-5 text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
          >
            Hi, I'm
            <span class="text-[var(--muted)]"> Kacper.</span>
          </h1>

          <p
            class="animate-item delay-200 mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)] sm:text-xl"
          >
            I'm a young developer interested in technology, programming, and
            continuous self-improvement.
          </p>

          <p
            class="animate-item delay-300 mt-5 max-w-2xl leading-7 text-[var(--muted)]"
          >
            I like building things, learning how they work, and documenting the
            process along the way.
          </p>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="border-b border-[var(--border)]">
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <div class="grid gap-16 lg:grid-cols-[1fr_1.5fr]">
          <div>
            <p
              class="text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
            >
              Who I am
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
              A developer who likes to understand things.
            </h2>
          </div>

          <div class="space-y-6 text-lg leading-8 text-[var(--muted)]">
            <p>
              I have a background in programming and enjoy working on projects
              where I can combine logic, creativity, and problem solving.
            </p>

            <p>
              Most of my time goes into learning new technologies, building web
              applications, experimenting with ideas, and improving the way I
              write code.
            </p>

            <p>
              I'm particularly interested in modern web development and creating
              interfaces that are simple, fast, and enjoyable to use.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interests -->
    <section class="border-b border-[var(--border)]">
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <div class="grid gap-16 lg:grid-cols-2">
          <div>
            <p
              class="text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
            >
              Beyond code
            </p>

            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
              More than programming.
            </h2>
          </div>

          <div class="space-y-6">
            <div
              class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-7"
            >
              <p class="text-xl font-semibold">Badminton</p>

              <p class="mt-3 leading-7 text-[var(--muted)]">
                Sport has been a big part of my life for years. It teaches me
                discipline, consistency, and patience.
              </p>
            </div>

            <div
              class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-7"
            >
              <p class="text-xl font-semibold">Learning</p>

              <p class="mt-3 leading-7 text-[var(--muted)]">
                I'm constantly trying to learn something new — whether it's
                programming, English, business, or something completely
                different.
              </p>
            </div>

            <div
              class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-7"
            >
              <p class="text-xl font-semibold">Building</p>

              <p class="mt-3 leading-7 text-[var(--muted)]">
                I enjoy turning ideas into working projects and learning from
                the problems I encounter along the way.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="border-b border-[var(--border)]">
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <div class="max-w-3xl">
          <p
            class="text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
          >
            My approach
          </p>

          <blockquote
            class="mt-6 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl"
          >
            "Small improvements every day eventually become something much
            bigger."
          </blockquote>

          <p class="mt-8 leading-7 text-[var(--muted)]">
            That's one of the reasons I started this blog. I want to keep track
            of what I learn, what I build, what works, and what doesn't.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section>
      <div class="mx-auto max-w-5xl px-6 py-20 text-center sm:py-28">
        <p
          class="text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          Keep exploring
        </p>

        <h2 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Want to see what I'm working on?
        </h2>

        <p class="mx-auto mt-5 max-w-xl leading-7 text-[var(--muted)]">
          Check out my latest posts and follow along as I learn, build, and
          improve.
        </p>

        <a
          href="/blog"
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-[var(--border)] bg-[var(--surface)] px-6 py-3 text-sm font-medium transition-all duration-300 hover:-translate-y-1 hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-lg"
        >
          Read my blog

          <span class="transition-transform duration-300 hover:translate-x-1">
            →
          </span>
        </a>
      </div>
    </section>
  </main>

  <!-- Animations -->
  <script>
    const animatedItems = document.querySelectorAll('.animate-item')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.1,
      },
    )

    animatedItems.forEach((item) => {
      observer.observe(item)
    })
  </script>

  <style>
    .animate-item {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(5px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease,
        filter 0.8s ease;
    }

    .animate-item.is-visible {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    .delay-100 {
      transition-delay: 100ms;
    }

    .delay-200 {
      transition-delay: 200ms;
    }

    .delay-300 {
      transition-delay: 300ms;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-item {
        opacity: 1;
        transform: none;
        filter: none;
        transition: none;
      }
    }
  </style>
</Layout>

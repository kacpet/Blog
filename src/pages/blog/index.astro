
---
import Layout from '../../layouts/Layout.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const modules = import.meta.glob('./content/*/*.astro', { eager: true })

const posts = Object.entries(modules)
  .map(([path, module]) => {
    const post = module.post

    return {
      ...post,
      path,
      slug: path.split('/')[2],
    }
  })
  .sort(
    (a, b) =>
      new Date(b.date).getTime() - new Date(a.date).getTime(),
  )

const visiblePosts = posts.slice(0, 5)
const hiddenPosts = posts.slice(5)
---

<Layout>
  <main>
    <!-- Hero -->
    <section class="border-b border-[var(--border)]">
      <div
        class="mx-auto max-w-7xl px-6 pb-20 pt-32 sm:pb-28 sm:pt-40"
      >
        <div class="max-w-4xl">
          <p
            class="animate-item text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
          >
            My blog · 2026
          </p>

          <h1
            class="animate-item delay-100 mt-5 text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl"
          >
            Welcome to my
            <span class="text-[var(--muted)]"> blog.</span>
          </h1>

          <p
            class="animate-item delay-200 mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)] sm:text-xl"
          >
            This is where I write about what I'm learning, what I'm
            building, what I'm reading, and how I'm trying to improve
            every day.
          </p>

          <p
            class="animate-item delay-300 mt-5 max-w-2xl leading-7 text-[var(--muted)]"
          >
            Every day is a small experiment. Some days are productive,
            some aren't. I'll document both.
          </p>
        </div>
      </div>
    </section>

    <!-- Posts -->
    <section>
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <div class="mb-12">
          <p
            class="text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
          >
            Archive
          </p>

          <h2
            class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
          >
            Recent days
          </h2>

          <p class="mt-4 max-w-2xl leading-7 text-[var(--muted)]">
            The latest things I've done, learned and thought about.
          </p>
        </div>

        {
          posts.length > 0 ? (
            <div class="divide-y divide-[var(--border)]">
              <!-- Visible posts -->
              {visiblePosts.map((post, index) => (
                <a
                  href={`${base}/blog/content/${post.slug}/${post.slug}/`}
                  class={`post-item group block py-8 transition-all duration-500 hover:px-4 ${
                    index === 0 ? 'pt-0' : ''
                  }`}
                >
                  <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                    <div class="max-w-3xl">
                      <div class="flex flex-wrap items-center gap-3 text-sm">
                        <span
                          class="font-medium text-[var(--secondary)]"
                        >
                          Day {post.day}
                        </span>

                        <span class="text-[var(--border)]">/</span>

                        <span class="text-[var(--muted)]">
                          {new Date(post.date).toLocaleDateString(
                            'en-GB',
                            {
                              day: 'numeric',
                              month: 'long',
                              year: 'numeric',
                            },
                          )}
                        </span>

                        {post.category && (
                          <>
                            <span class="text-[var(--border)]">
                              /
                            </span>

                            <span class="text-[var(--muted)]">
                              {post.category}
                            </span>
                          </>
                        )}
                      </div>

                      <h3
                        class="mt-3 text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-[var(--secondary)] sm:text-3xl"
                      >
                        {post.title}
                      </h3>

                      <p class="mt-3 leading-7 text-[var(--muted)]">
                        {post.description}
                      </p>
                    </div>

                    <span
                      class="shrink-0 text-xl text-[var(--secondary)] transition-transform duration-300 group-hover:translate-x-2"
                    >
                      →
                    </span>
                  </div>
                </a>
              ))}

              <!-- Hidden posts -->
              {hiddenPosts.length > 0 && (
                <div id="hidden-posts" class="hidden">
                  {hiddenPosts.map((post) => (
                    <a
                      href={`${base}/blog/content/${post.slug}/${post.slug}/`}
                      class="post-item group block py-8 transition-all duration-500 hover:px-4"
                    >
                      <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                        <div class="max-w-3xl">
                          <div class="flex flex-wrap items-center gap-3 text-sm">
                            <span
                              class="font-medium text-[var(--secondary)]"
                            >
                              Day {post.day}
                            </span>

                            <span class="text-[var(--border)]">
                              /
                            </span>

                            <span class="text-[var(--muted)]">
                              {new Date(
                                post.date,
                              ).toLocaleDateString('en-GB', {
                                day: 'numeric',
                                month: 'long',
                                year: 'numeric',
                              })}
                            </span>

                            {post.category && (
                              <>
                                <span
                                  class="text-[var(--border)]"
                                >
                                  /
                                </span>

                                <span class="text-[var(--muted)]">
                                  {post.category}
                                </span>
                              </>
                            )}
                          </div>

                          <h3
                            class="mt-3 text-2xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-[var(--secondary)] sm:text-3xl"
                          >
                            {post.title}
                          </h3>

                          <p class="mt-3 leading-7 text-[var(--muted)]">
                            {post.description}
                          </p>
                        </div>

                        <span
                          class="shrink-0 text-xl text-[var(--secondary)] transition-transform duration-300 group-hover:translate-x-2"
                        >
                          →
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <div
              class="rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-10 text-center"
            >
              <p class="text-lg font-medium">
                No posts yet.
              </p>

              <p class="mt-2 text-[var(--muted)]">
                The first day will appear here soon.
              </p>
            </div>
          )
        }

        <!-- Show more button -->
        {
          hiddenPosts.length > 0 && (
            <div
              id="show-more-container"
              class="mt-12 flex justify-center"
            >
              <button
                id="show-more"
                type="button"
                class="group inline-flex items-center gap-3 rounded-full border border-[var(--border)] bg-[var(--surface)] px-6 py-3 text-sm font-medium transition-all duration-300 hover:-translate-y-1 hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-lg"
              >
                <span id="show-more-text">
                  Show all posts
                </span>

                <span
                  id="show-more-icon"
                  class="transition-transform duration-300"
                >
                  ↓
                </span>
              </button>
            </div>
          )
        }
      </div>
    </section>
  </main>

  <!-- Show more / Show less -->
  <script>
    const button = document.querySelector('#show-more')
    const hiddenPosts = document.querySelector('#hidden-posts')
    const buttonText = document.querySelector('#show-more-text')
    const buttonIcon = document.querySelector('#show-more-icon')

    if (
      button &&
      hiddenPosts &&
      buttonText &&
      buttonIcon
    ) {
      button.addEventListener('click', () => {
        const isHidden =
          hiddenPosts.classList.contains('hidden')

        if (isHidden) {
          hiddenPosts.classList.remove('hidden')

          buttonText.textContent = 'Show less'
          buttonIcon.textContent = '↑'
          buttonIcon.classList.add('rotate-180')
        } else {
          hiddenPosts.classList.add('hidden')

          buttonText.textContent = 'Show all posts'
          buttonIcon.textContent = '↓'
          buttonIcon.classList.remove('rotate-180')

          const postsSection =
            document.querySelector('section:nth-of-type(2)')

          if (postsSection) {
            postsSection.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            })
          }
        }
      })
    }
  </script>

  <!-- Animations -->
  <script>
    const animatedItems =
      document.querySelectorAll('.animate-item')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      {
        threshold: 0.1,
      },
    )

    animatedItems.forEach((item) => {
      observer.observe(item)
    })
  </script>

  <style>
    .animate-item {
      opacity: 0;
      transform: translateY(30px);
      filter: blur(5px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease,
        filter 0.8s ease;
    }

    .animate-item.is-visible {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    .delay-100 {
      transition-delay: 100ms;
    }

    .delay-200 {
      transition-delay: 200ms;
    }

    .delay-300 {
      transition-delay: 300ms;
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-item {
        opacity: 1;
        transform: none;
        filter: none;
        transition: none;
      }
    }
  </style>
</Layout>




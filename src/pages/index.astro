---
import Layout from '../layouts/Layout.astro'

const modules = import.meta.glob('./blog/content/*/*.astro', { eager: true })

const posts = Object.entries(modules)
  .map(([path, module]) => {
    const post = module.post

    return {
      ...post,
      path,
      slug: path.split('/')[3],
    }
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())

const latestPost = posts[0]
const latestPosts = posts.slice(0, 3)
---

<Layout>
  <!-- Hero -->
  <section
    class="scroll-section flex min-h-screen snap-start items-center overflow-hidden"
  >
    <div class="mx-auto w-full max-w-7xl px-6 py-20">
      <div class="hero-content max-w-4xl">
        <p
          class="animate-item mb-6 text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
        >
          MY BLOG · 2026
        </p>

        <h1
          class="animate-item delay-100 text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl lg:leading-20"
        >
          I make things,
          <br />
          learn along the way,
          <br />
          <span class="text-[var(--muted)]"> and write about it here. </span>
        </h1>

        <p
          class="animate-item delay-200 mt-8 max-w-2xl text-lg leading-8 text-[var(--muted)]"
        >
          A place where I share what I'm learning through programming, building
          projects, and personal growth.
        </p>

        <div class="animate-item delay-300 mt-10 flex flex-wrap gap-4">
          <a
            href="/blog"
            class="rounded-full bg-[var(--secondary)] px-6 py-3 text-sm font-medium text-white transition-all duration-300 hover:-translate-y-1 hover:opacity-80 hover:shadow-lg"
          >
            Read the blog
          </a>

          <a
            href="/about"
            class="rounded-full border border-[var(--border)] bg-[var(--surface)] px-6 py-3 text-sm font-medium transition-all duration-300 hover:-translate-y-1 hover:border-[var(--secondary)] hover:text-[var(--secondary)] hover:shadow-lg"
          >
            About me
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Today's post -->
  {
    latestPost && (
      <section class="scroll-section flex min-h-screen snap-start items-center border-y border-[var(--border)] overflow-hidden">
        <div class="mx-auto w-full max-w-7xl px-6 py-20">
          <div class="section-content">
            <div class="mb-8 flex items-center justify-between">
              <div>
                <p class="animate-item text-sm font-medium uppercase tracking-widest text-[var(--secondary)]">
                  Today
                </p>

                <h2 class="animate-item delay-100 mt-2 text-3xl font-bold tracking-tight">
                  Day {latestPost.day}
                </h2>
              </div>

              <span class="animate-item delay-100 text-sm text-[var(--muted)]">
                {new Date(latestPost.date).toLocaleDateString('en-US')}
              </span>
            </div>

            <a
              href={`/blog/content/${latestPost.slug}/${latestPost.slug}`}
              class="animate-item delay-200 group block rounded-3xl border border-[var(--border)] bg-[var(--surface)] p-8 transition-all duration-500 hover:-translate-y-2 hover:border-[var(--secondary)] hover:shadow-2xl sm:p-10"
            >
              <div class="max-w-3xl">
                <p class="text-sm text-[var(--secondary)]">
                  {latestPost.category}
                </p>

                <h3 class="mt-3 text-3xl font-semibold tracking-tight transition-colors duration-300 group-hover:text-[var(--secondary)] sm:text-4xl">
                  {latestPost.title}
                </h3>

                <p class="mt-4 leading-7 text-[var(--muted)]">
                  {latestPost.description}
                </p>

                <div class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-[var(--secondary)]">
                  Read post
                  <span class="transition-transform duration-300 group-hover:translate-x-2">
                    →
                  </span>
                </div>
              </div>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Latest posts -->
  <section
    class="scroll-section flex min-h-screen snap-start items-center overflow-hidden"
  >
    <div class="mx-auto w-full max-w-7xl px-6 py-20">
      <div class="section-content">
        <div class="flex items-end justify-between">
          <div>
            <p
              class="animate-item text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
            >
              Archive
            </p>

            <h2
              class="animate-item delay-100 mt-2 text-3xl font-bold tracking-tight"
            >
              Latest posts
            </h2>
          </div>

          <a
            href="/blog"
            class="animate-item delay-200 hidden text-sm font-medium text-[var(--secondary)] transition-opacity hover:opacity-60 sm:block"
          >
            View all →
          </a>
        </div>

        <div
          class="animate-item delay-200 mt-10 divide-y divide-[var(--border)]"
        >
          {
            latestPosts.map((post, index) => (
              <a
                href={`/blog/content/${post.slug}/${post.slug}`}
                class={`group flex flex-col gap-3 py-7 transition-all duration-500 hover:px-4 sm:flex-row sm:items-center sm:justify-between ${
                  index === 0 ? 'first-post' : ''
                }`}
              >
                <div>
                  <p class="text-sm text-[var(--muted)]">
                    {new Date(post.date).toLocaleDateString('en-US')}· Day{' '}
                    {post.day}
                  </p>

                  <h3 class="mt-1 text-xl font-medium transition-colors duration-300 group-hover:text-[var(--secondary)]">
                    {post.title}
                  </h3>
                </div>

                <span class="text-[var(--secondary)] transition-transform duration-300 group-hover:translate-x-2">
                  →
                </span>
              </a>
            ))
          }
        </div>

        <a
          href="/blog"
          class="animate-item delay-300 mt-8 block text-sm font-medium text-[var(--secondary)] transition-opacity hover:opacity-60 sm:hidden"
        >
          View all posts →
        </a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section
    class="scroll-section flex min-h-screen snap-start items-center border-t border-[var(--border)] overflow-hidden"
  >
    <div class="mx-auto w-full max-w-7xl px-6 py-20">
      <div class="section-content grid gap-10 md:grid-cols-2 md:items-center">
        <div>
          <p
            class="animate-item text-sm font-medium uppercase tracking-widest text-[var(--secondary)]"
          >
            A few words
          </p>

          <h2
            class="animate-item delay-100 mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
          >
            Who am I?
          </h2>
        </div>

        <div>
          <p class="animate-item delay-200 leading-8 text-[var(--muted)]">
            I'm interested in programming, technology, and continuous
            self-improvement. I enjoy building things from scratch,
            experimenting, and seeing how far I can go while learning new
            things.
          </p>

          <a
            href="about/"
            class="animate-item delay-300 mt-6 inline-block text-sm font-medium text-[var(--secondary)] transition-all duration-300 hover:translate-x-1 hover:opacity-60"
          >
            Learn more →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Animations -->
  <script>
    const sections = document.querySelectorAll('.scroll-section')

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
          }
        })
      },
      {
        threshold: 0.35,
      },
    )

    sections.forEach((section) => {
      observer.observe(section)
    })
  </script>

  <!-- Page styles -->
  <style>
    html {
      scroll-behavior: smooth;
      scroll-snap-type: y mandatory;
    }

    .scroll-section {
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .animate-item {
      opacity: 0;
      transform: translateY(35px);
      filter: blur(5px);
      transition:
        opacity 0.8s ease,
        transform 0.8s ease,
        filter 0.8s ease;
    }

    .is-visible .animate-item {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }

    .delay-100 {
      transition-delay: 100ms;
    }

    .delay-200 {
      transition-delay: 200ms;
    }

    .delay-300 {
      transition-delay: 300ms;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      .animate-item {
        opacity: 1;
        transform: none;
        filter: none;
        transition: none;
      }
    }
  </style>
</Layout>
